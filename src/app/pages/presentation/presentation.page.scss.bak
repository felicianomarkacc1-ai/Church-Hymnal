// Stage tokens. Warm and near-black, tuned for legibility in a dark room —
// deliberately not the generic navy/indigo "dark mode" gradient.
:host {
  --stage-bg: #14100c;
  --stage-bg-edge: #0a0806;
  --stage-glow: rgba(201, 138, 63, 0.14);
  --stage-text: #f5efe2;
  --stage-text-soft: #b9ac95;
  --stage-accent: #c98a3f;
  --stage-rule: rgba(245, 239, 226, 0.14);
  --stage-overlay: rgba(10, 8, 6, 0.92);

  --stage-font-display: 'Fraunces', Georgia, 'Times New Roman', serif;
  --stage-font-body: 'Source Serif 4', Georgia, serif;

  display: block;
}

ion-content.presentation-content {
  --background: var(--stage-bg);
  --color: var(--stage-text);
}

.presentation-area {
  width: 100%;
  height: 100%;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 36px 20px 110px;
  position: relative;
  background: radial-gradient(circle at 50% 0%, var(--stage-glow) 0%, var(--stage-bg) 55%, var(--stage-bg-edge) 100%);
  color: var(--stage-text);
  cursor: pointer;
  overflow: hidden;
}

.tap-zone {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 28%;
  z-index: 1;

  &.tap-zone-left {
    left: 0;
  }

  &.tap-zone-right {
    right: 0;
  }
}

// ---------------------------------------------
// Corner tag — replaces a large centered header so the lyrics
// get the vertical space; this screen's job is the words, not the chrome.
// ---------------------------------------------
.stage-tag {
  position: absolute;
  top: 18px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2;
  display: flex;
  align-items: baseline;
  gap: 12px;
  justify-content: center;
  font-family: var(--stage-font-body);
  font-size: 1.25rem;
  color: var(--stage-text-soft);
  letter-spacing: 0.04em;
  max-width: calc(100% - 48px);
  text-align: center;
}

.stage-tag-number {
  flex: 0 0 auto;
  color: var(--stage-accent);
  font-weight: 700;
  font-size: 1.3rem;
}

.stage-tag-title {
  font-size: 1.3rem;
  font-weight: 600;
  color: var(--stage-text);
}

.stage-tag-title {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.presentation-back-btn {
  position: absolute;
  top: 18px;
  right: 18px;
  z-index: 4;
  --border-radius: 999px;
  --padding-start: 10px;
  --padding-end: 10px;
  --icon-size: 26px;
  color: var(--stage-text);
}

// ---------------------------------------------
// The lyrics themselves — the whole point of the screen
// ---------------------------------------------
.presentation-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  max-width: 900px;
  width: 100%;
  z-index: 2;
  padding: 0 12px;

  .section-label {
    font-family: var(--stage-font-body);
    font-style: italic;
    font-size: 15px;
    color: var(--stage-accent);
    margin: 0 0 22px;
    text-transform: uppercase;
    letter-spacing: 3px;
  }

  .lyrics-text {
    font-family: var(--stage-font-display);
    font-weight: 500;
    line-height: 1.5;
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  &.font-xs .lyrics-text {
    font-size: 22px;
  }

  &.font-sm .lyrics-text {
    font-size: 34px;
  }

  &.font-md .lyrics-text {
    font-size: 48px;
  }

  &.font-lg .lyrics-text {
    font-size: 64px;
  }

  &.font-xl .lyrics-text {
    font-size: 80px;
  }
}

// ---------------------------------------------
// Bottom cluster — progress dots + quick-jump chips, always
// on screen (not buried behind the tap-to-reveal controls)
// so a live jump to "Chorus" is always one tap away.
// ---------------------------------------------
.bottom-cluster {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  padding: 18px 20px calc(18px + env(safe-area-inset-bottom));
  background: linear-gradient(to top, var(--stage-bg-edge) 0%, rgba(10, 8, 6, 0) 100%);
}

.progress-dots {
  display: flex;
  gap: 8px;
}

.side-nav-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 4;
  width: 46px;
  height: 46px;
  --border-radius: 999px;
  border: 1px solid rgba(245, 239, 226, 0.16);
  background: rgba(245, 239, 226, 0.09);
  color: var(--stage-text);
  display: flex;
  align-items: center;
  justify-content: center;
}

.side-nav-btn-left {
  left: 12px;
}

.side-nav-btn-right {
  right: 12px;
}

.side-nav-btn[disabled] {
  opacity: 0.35;
}

.dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--stage-rule);
  transition: background-color 0.2s ease, transform 0.2s ease;

  &.dot-active {
    background: var(--stage-accent);
    transform: scale(1.3);
  }
}

// ---------------------------------------------
// Bottom cluster — progress dots + quick-jump chips + permanent font controls.
// ---------------------------------------------
.font-control-bottom {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 12px;
  background: rgba(245, 239, 226, 0.08);
  border: 1px solid var(--stage-rule);
  border-radius: 999px;
  padding: 10px 14px;
}

.font-control-bottom span {
  font-family: var(--stage-font-body);
  font-size: 12px;
  color: var(--stage-text-soft);
}

.font-control-bottom .font-value {
  font-family: var(--stage-font-display);
  font-size: 14px;
  color: var(--stage-text);
  min-width: 22px;
  text-align: center;
}

.font-control-bottom ion-button {
  width: 38px;
  height: 38px;
  --border-radius: 999px;
}

.quick-jump {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 6px;
  max-width: 640px;
}

.quick-jump-chip {
  font-family: var(--stage-font-body);
  font-size: 12px;
  color: var(--stage-text);
  background: rgba(245, 239, 226, 0.08);
  border: 1px solid var(--stage-rule);
  border-radius: 999px;
  padding: 6px 12px;
  min-width: 68px;
  cursor: pointer;
  transition: background-color 0.15s ease, border-color 0.15s ease, opacity 0.15s ease;

  &:hover:not(:disabled) {
    background: rgba(201, 138, 63, 0.16);
    border-color: var(--stage-accent);
  }

  &:focus-visible {
    outline: 2px solid var(--stage-accent);
    outline-offset: 2px;
  }

  &.quick-jump-chip-active {
    background: var(--stage-accent);
    border-color: var(--stage-accent);
    color: var(--stage-bg-edge);
    font-weight: 600;
  }

  &:disabled {
    opacity: 0.2;
    cursor: default;
  }
}

@media (max-width: 768px) {
  .stage-tag {
    font-size: 0.72rem;
  }

  .presentation-main {
    &.font-xs .lyrics-text {
      font-size: 17px;
    }

    &.font-sm .lyrics-text {
      font-size: 24px;
    }

    &.font-md .lyrics-text {
      font-size: 32px;
    }

    &.font-lg .lyrics-text {
      font-size: 48px;
    }

    &.font-xl .lyrics-text {
      font-size: 64px;
    }
  }

  .controls-middle {
    flex-direction: column;
    gap: 20px;

    .controls-center .font-control {
      flex-direction: column;
    }
  }
}