// Fonts for the manuscript identity. For production, move this @import (or the
// equivalent <link> tags) into index.html so it's fetched once, globally, instead
// of per-component.
@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap');

// ---------------------------------------------
// Local design tokens — a hymnal page, not a form
// ---------------------------------------------
:host {
  --hymn-paper: var(--app-surface-bg, #faf6ec);
  --hymn-paper-shade: var(--app-surface-alt-bg, #f1ead9);
  --hymn-ink: var(--app-text, #2b241d);
  --hymn-ink-soft: var(--app-text-muted, #6e6252);
  --hymn-rule: var(--app-border, #ded1b8);
  --hymn-maroon: #7c2e2e;
  --hymn-maroon-shade: #631f1f;
  --hymn-gold: #a9813e;

  --hymn-font-display: 'Fraunces', Georgia, 'Times New Roman', serif;
  --hymn-font-body: 'Source Serif 4', Georgia, serif;

  display: block;
}

.hymn-header ion-toolbar {
  --background: var(--hymn-paper);
  --color: var(--hymn-ink);
  --border-color: var(--hymn-rule);
  font-family: var(--hymn-font-display);
}

.save-action {
  --color: var(--hymn-maroon);
}

.hymn-editor-content {
  --background: var(--hymn-paper);
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

// ---------------------------------------------
// Page shell
// ---------------------------------------------
.manuscript {
  max-width: 640px;
  margin: 0 auto;
  padding: 20px 20px 40px;
}

// ---------------------------------------------
// Title plate — the signature element: an inked, slightly
// stamped number plate, the way a hymnal announces its number.
// ---------------------------------------------
.plate {
  display: flex;
  align-items: stretch;
  gap: 18px;
  padding: 22px 20px;
  margin-bottom: 28px;
  background: var(--hymn-paper);
  border: 1px solid var(--hymn-rule);
  border-radius: 4px;
  box-shadow: 0 1px 0 rgba(43, 36, 29, 0.04);
  animation: plateIn 0.4s ease-out;
}

@media (prefers-reduced-motion: reduce) {
  .plate {
    animation: none;
  }
}

@keyframes plateIn {
  from {
    opacity: 0;
    transform: translateY(6px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.plate-number {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-width: 84px;
  padding: 6px 8px;
  border: 1.5px solid var(--hymn-maroon);
  border-radius: 3px;
  transform: rotate(-1deg);
  position: relative;

  &::after {
    // faint letterpress ring, suggests a stamped plate rather than a flat box
    content: '';
    position: absolute;
    inset: 4px;
    border: 1px solid rgba(124, 46, 46, 0.25);
    border-radius: 2px;
    pointer-events: none;
  }
}

.plate-number-label {
  font-family: var(--hymn-font-body);
  font-style: italic;
  font-size: 0.7rem;
  color: var(--hymn-ink-soft);
  letter-spacing: 0.04em;
}

.plate-number-input {
  width: 100%;
  border: none;
  background: transparent;
  font-family: var(--hymn-font-display);
  font-weight: 700;
  font-size: 2.1rem;
  line-height: 1.1;
  color: var(--hymn-maroon);
  text-align: center;

  &::placeholder {
    color: rgba(124, 46, 46, 0.35);
  }

  &::-webkit-outer-spin-button,
  &::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  -moz-appearance: textfield;

  &:focus-visible {
    outline: 2px solid var(--hymn-gold);
    outline-offset: 2px;
    border-radius: 2px;
  }
}

.plate-divider {
  width: 1px;
  align-self: stretch;
  background: var(--hymn-rule);
}

.plate-title {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.plate-title-input {
  width: 100%;
  border: none;
  border-bottom: 1px solid var(--hymn-rule);
  background: transparent;
  padding-bottom: 6px;
  font-family: var(--hymn-font-display);
  font-weight: 600;
  font-size: 1.5rem;
  color: var(--hymn-ink);

  &::placeholder {
    color: var(--hymn-ink-soft);
    font-weight: 400;
  }

  &:focus-visible {
    outline: none;
    border-bottom-color: var(--hymn-maroon);
  }
}

.plate-caption {
  margin-top: 8px;
  font-family: var(--hymn-font-body);
  font-style: italic;
  font-size: 0.85rem;
  color: var(--hymn-ink-soft);
}

// ---------------------------------------------
// Lyrics manuscript
// ---------------------------------------------
.lyrics-block {
  margin-bottom: 24px;
}

.lyrics-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 10px;
}

.eyebrow {
  font-family: var(--hymn-font-body);
  font-style: italic;
  font-size: 0.85rem;
  letter-spacing: 0.02em;
  color: var(--hymn-ink-soft);
}

.section-badge {
  font-family: var(--hymn-font-body);
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--hymn-maroon);
  background: rgba(124, 46, 46, 0.08);
  border: 1px solid rgba(124, 46, 46, 0.18);
  border-radius: 999px;
  padding: 3px 10px;
}

.lyrics-frame {
  background: var(--hymn-paper);
  border: 1px solid var(--hymn-rule);
  border-radius: 4px;
  padding: 4px;
}

.lyrics-input {
  --background: transparent;
  --color: var(--hymn-ink);
  --placeholder-color: var(--hymn-ink-soft);
  --placeholder-opacity: 0.7;
  --padding-start: 16px;
  --padding-end: 16px;
  --padding-top: 14px;
  --padding-bottom: 14px;
  font-family: var(--hymn-font-body);
  font-size: 1rem;
  line-height: 1.8;

  // faint ruled lines behind the text, like manuscript paper
  background-image: repeating-linear-gradient(
    to bottom,
    transparent,
    transparent 1.79em,
    var(--hymn-paper-shade) 1.79em,
    var(--hymn-paper-shade) calc(1.79em + 1px)
  );
  border-radius: 3px;
}

.marginalia {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  margin-top: 14px;
  padding: 14px 16px;
  background: var(--hymn-paper-shade);
  border-left: 2px solid var(--hymn-gold);
  border-radius: 0 4px 4px 0;

  p {
    margin: 0;
    font-family: var(--hymn-font-body);
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--hymn-ink-soft);
  }

  code {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.82em;
    color: var(--hymn-maroon);
    background: rgba(124, 46, 46, 0.07);
    padding: 1px 5px;
    border-radius: 3px;
  }
}

.marginalia-mark {
  flex: 0 0 auto;
  font-size: 1rem;
  color: var(--hymn-gold);
  line-height: 1.55;
}

// ---------------------------------------------
// Actions
// ---------------------------------------------
.actions {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.save-btn {
  --background: var(--hymn-maroon);
  --background-hover: var(--hymn-maroon-shade);
  --background-activated: var(--hymn-maroon-shade);
  --color: #fff;
  --border-radius: 6px;
  --box-shadow: none;
  font-family: var(--hymn-font-display);
  font-weight: 600;
  letter-spacing: 0.01em;
  height: 48px;
}

.cancel-btn {
  --color: var(--hymn-ink-soft);
  font-family: var(--hymn-font-body);
}

// ---------------------------------------------
// Small screens
// ---------------------------------------------
@media (max-width: 400px) {
  .plate {
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .plate-divider {
    width: 100%;
    height: 1px;
  }

  .plate-number {
    align-self: flex-start;
    min-width: 64px;
  }
}